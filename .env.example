# Skopiuj do pliku .env (lokalnie) i/lub ustaw te zmienne w panelu Vercela.
# NIE commituj prawdziwego pliku .env.

# --- Podstawy ---
# Wygeneruj: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=zmien-mnie-na-losowy-klucz
DEBUG=False
# Dodatkowe hosty po przecinku (vercel.app jest dodawany automatycznie):
ALLOWED_HOSTS=
# Pełne originy https dla CSRF, jeśli masz własną domenę, po przecinku:
CSRF_TRUSTED_ORIGINS=

# --- Baza danych (Postgres na produkcji; bez tego lokalnie SQLite) ---
# Neon / Vercel Postgres / Supabase, format:
# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# --- Pliki/zdjęcia (Cloudinary na produkcji; bez tego lokalnie media/) ---
# Z dashboardu Cloudinary, format:
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# --- E-mail (formularz kontaktowy) ---
# Bez tego maile lecą do konsoli. Dla Gmaila uzyj "hasla aplikacji" (App Password).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=twoj-adres@gmail.com
EMAIL_HOST_PASSWORD=haslo-aplikacji-gmail
CONTACT_RECIPIENT=odbiorca@gmail.com
